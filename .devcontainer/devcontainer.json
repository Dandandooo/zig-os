{
	"name": "Zebian",

	"build": {
		"dockerfile": "Dockerfile",
		"context": "."
	},

	// Retrieve host timezone
	"initializeCommand": "echo TZ=$(readlink /etc/localtime | sed \"s#.*/zoneinfo/##\") > .devcontainer/devcontainer.env",

	"runArgs": [
		"--hostname=ziggy",
		"--env-file=.devcontainer/devcontainer.env"
	],

	"customizations": {
		"vscode": {
			"extensions": [
				"ziglang.vscode-zig",
				"prime31.zig",
				"vadimcn.vscode-lldb",
				"llvm-vs-code-extensions.lldb-dap",
				"zhwu95.riscv",
				"ms-vscode.hexeditor",
				"Gruntfuggly.todo-tree"
			]
		}
	}
}
